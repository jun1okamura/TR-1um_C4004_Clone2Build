MACRO AND2_X1
  CLASS CORE ;
  FOREIGN AND2_X1 0.000 0.000 ;
  ORIGIN 0.000 0.000 ;
  SIZE 21.600 BY 59.400 ;
  SYMMETRY X Y ;
  SITE TR1UM ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER METAL2 ;
        RECT 1.000 28.000 4.400 31.400 ;
    END
  END A
  PIN B
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER METAL2 ;
        RECT 6.400 28.000 9.800 31.400 ;
    END
  END B
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER METAL2 ;
        RECT 17.200 28.000 20.600 31.400 ;
    END
  END Y
  PIN vdd
    DIRECTION INOUT ;
    USE POWER ;
    SHAPE ABUTMENT ;
    PORT
      LAYER METAL1 ;
        RECT 0.000 55.700 21.600 58.300 ;
    END
  END vdd
  PIN vss
    DIRECTION INOUT ;
    USE GROUND ;
    SHAPE ABUTMENT ;
    PORT
      LAYER METAL1 ;
        RECT 0.000 1.100 21.600 3.700 ;
    END
  END vss
  OBS
    LAYER METAL1 ;
      RECT 0.000 0.000 21.600 59.400 ;
    LAYER VIA1 ;
      RECT 0.000 0.000 21.600 59.400 ;
  END
END AND2_X1

